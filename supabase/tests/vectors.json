    { "name": "ALI", "ue_canonical_key": "ali", "ue_is_reserved": false, "db_key": "ali", "db_reserved": false },
    { "name": "Ali Veli", "ue_canonical_key": "ali_veli", "ue_is_reserved": false, "db_key": "ali_veli", "db_reserved": false },
    { "name": "ali_veli", "ue_canonical_key": "ali_veli", "ue_is_reserved": false, "db_key": "ali_veli", "db_reserved": false, "note": "ayni anahtar: 'Ali Veli' ile cakisir (tek kayit)" },
    { "name": "A B", "ue_canonical_key": "a_b", "ue_is_reserved": false, "db_key": "a_b", "db_reserved": false },
