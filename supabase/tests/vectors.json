  "scenarios": [
    {
      "id": "happy_path",
      "description": "create -> save -> release -> baska sunucu acquire: veri ve yan veri geri gelir, epoch 2",
      "steps": [
        { "rpc": "create_character", "args": { "p_key": "zz-v-happy", "p_display_name": "ZZ-V-Happy", "p_holder": "srvA:boot1", "p_op_id": "00000000-0000-4000-8000-000000000001", "p_schema_version": 2, "p_data": "@envelope_a", "p_race": "test_race" },
          "expect": { "outcome": "committed", "canonical_key": "zz-v-happy", "revision": 0, "epoch": 1 } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-happy", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000002", "p_schema_version": 2, "p_data": "@envelope_b", "p_side": "@side_ok" },
          "expect": { "outcome": "committed", "revision": 1, "epoch": 1 } },
        { "rpc": "release_lease", "args": { "p_key": "zz-v-happy", "p_holder": "srvA:boot1", "p_epoch": 1 },
          "expect": { "outcome": "ok" } },
        { "rpc": "acquire_lease", "args": { "p_key": "zz-v-happy", "p_holder": "srvB:boot2", "p_ttl_s": 120 },
          "expect": { "outcome": "ok", "epoch": 2, "revision": 1, "schema_version": 2, "data": "@envelope_b", "side": "@side_ok", "display_name": "ZZ-V-Happy", "race": "test_race" } },
        { "rpc": "load_character", "args": { "p_key": "zz-v-happy" },
          "expect": { "outcome": "ok", "revision": 1, "data": "@envelope_b", "active_server": "srvB:boot2", "lease_epoch": 2 } }
      ]
    },
    {
      "id": "stale_revision",
      "description": "eski expected_revision reddedilir, mevcut revision doner; dogru revision ile yazilir",
      "steps": [
        { "rpc": "create_character", "args": { "p_key": "zz-v-stale", "p_display_name": "zz-v-stale", "p_holder": "srvA:boot1", "p_op_id": "00000000-0000-4000-8000-000000000003", "p_schema_version": 2, "p_data": "@envelope_a" },
          "expect": { "outcome": "committed", "revision": 0, "epoch": 1 } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-stale", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000004", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "committed", "revision": 1 } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-stale", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000005", "p_schema_version": 2, "p_data": "@envelope_c" },
          "expect": { "outcome": "revision_conflict", "revision": 1 }, "exact": true },
        { "rpc": "load_character", "args": { "p_key": "zz-v-stale" },
          "expect": { "revision": 1, "data": "@envelope_b" } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-stale", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 1, "p_op_id": "00000000-0000-4000-8000-000000000006", "p_schema_version": 2, "p_data": "@envelope_c" },
          "expect": { "outcome": "committed", "revision": 2 } }
      ]
    },
    {
      "id": "dead_epoch",
      "description": "kira baska sunucuya gecince eski sunucunun (olu epoch) yazimi reddedilir",
      "steps": [
        { "rpc": "create_character", "args": { "p_key": "zz-v-epoch", "p_display_name": "zz-v-epoch", "p_holder": "srvA:boot1", "p_op_id": "00000000-0000-4000-8000-000000000007", "p_schema_version": 2, "p_data": "@envelope_a" },
          "expect": { "outcome": "committed", "epoch": 1 } },
        { "rpc": "release_lease", "args": { "p_key": "zz-v-epoch", "p_holder": "srvA:boot1", "p_epoch": 1 },
          "expect": { "outcome": "ok" } },
        { "rpc": "acquire_lease", "args": { "p_key": "zz-v-epoch", "p_holder": "srvB:boot2", "p_ttl_s": 120 },
          "expect": { "outcome": "ok", "epoch": 2, "revision": 0 } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-epoch", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000008", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "ownership_lost", "epoch": 2 } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-epoch", "p_holder": "srvA:boot1", "p_epoch": 2, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000009", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "ownership_lost" } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-epoch", "p_holder": "srvB:boot2", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000010", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "ownership_lost" } },
        { "rpc": "release_lease", "args": { "p_key": "zz-v-epoch", "p_holder": "srvA:boot1", "p_epoch": 1 },
          "expect": { "outcome": "ownership_lost" } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-epoch", "p_holder": "srvB:boot2", "p_epoch": 2, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000011", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "committed", "revision": 1, "epoch": 2 } }
      ]
    },
    {
      "id": "live_lease_blocks_other",
      "description": "gecerli kira baska sunucuya verilmez; ayni sunucu tekrar alirsa epoch artmaz",
      "steps": [
        { "rpc": "create_character", "args": { "p_key": "zz-v-lease", "p_display_name": "zz-v-lease", "p_holder": "srvA:boot1", "p_op_id": "00000000-0000-4000-8000-000000000012", "p_schema_version": 2, "p_data": "@envelope_a" },
          "expect": { "outcome": "committed", "epoch": 1 } },
        { "rpc": "acquire_lease", "args": { "p_key": "zz-v-lease", "p_holder": "srvB:boot2", "p_ttl_s": 120 },
          "expect": { "outcome": "ownership_lost" } },
        { "rpc": "acquire_lease", "args": { "p_key": "zz-v-lease", "p_holder": "srvA:boot1", "p_ttl_s": 120 },
          "expect": { "outcome": "ok", "epoch": 1, "revision": 0 } }
      ]
    },
    {
      "id": "expired_lease",
      "description": "suresi dolmus kira ile yazim reddedilir; yeni acquire epoch+1 verir",
      "steps": [
        { "rpc": "create_character", "args": { "p_key": "zz-v-expire", "p_display_name": "zz-v-expire", "p_holder": "srvA:boot1", "p_op_id": "00000000-0000-4000-8000-000000000013", "p_schema_version": 2, "p_data": "@envelope_a" },
          "expect": { "outcome": "committed", "epoch": 1 } },
        { "admin": "expire_lease", "key": "zz-v-expire" },
        { "rpc": "save_character", "args": { "p_key": "zz-v-expire", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000014", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "ownership_lost" } },
        { "rpc": "renew_lease", "args": { "p_key": "zz-v-expire", "p_holder": "srvA:boot1", "p_epoch": 1 },
          "expect": { "outcome": "ownership_lost" } },
        { "rpc": "acquire_lease", "args": { "p_key": "zz-v-expire", "p_holder": "srvB:boot2", "p_ttl_s": 120 },
          "expect": { "outcome": "ok", "epoch": 2, "revision": 0 } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-expire", "p_holder": "srvB:boot2", "p_epoch": 2, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000015", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "committed", "revision": 1 } }
      ]
    },
    {
      "id": "idempotent_same_payload",
      "description": "ayni op_id + ayni yuk: tek etki, kayitli sonuc (replayed); kira bitse de kayitli sonuc doner; get_op uzlastirir",
      "steps": [
        { "rpc": "create_character", "args": { "p_key": "zz-v-idem", "p_display_name": "zz-v-idem", "p_holder": "srvA:boot1", "p_op_id": "00000000-0000-4000-8000-000000000016", "p_schema_version": 2, "p_data": "@envelope_a" },
          "expect": { "outcome": "committed", "epoch": 1 } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-idem", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000017", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "committed", "revision": 1, "epoch": 1 }, "exact": true },
        { "rpc": "save_character", "args": { "p_key": "zz-v-idem", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000017", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "committed", "revision": 1, "epoch": 1, "replayed": true }, "exact": true },
        { "rpc": "get_op", "args": { "p_op_id": "00000000-0000-4000-8000-000000000017" },
          "expect": { "outcome": "ok", "op_kind": "save", "canonical_key": "zz-v-idem", "result": { "outcome": "committed", "revision": 1, "epoch": 1 } } },
        { "admin": "expire_lease", "key": "zz-v-idem" },
        { "rpc": "save_character", "args": { "p_key": "zz-v-idem", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000017", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "committed", "revision": 1, "replayed": true } },
        { "rpc": "load_character", "args": { "p_key": "zz-v-idem" },
          "expect": { "revision": 1, "data": "@envelope_b" } }
      ]
    },
    {
      "id": "idempotent_different_payload",
      "description": "ayni op_id + farkli yuk (veri ya da expected_revision) idempotency_conflict; durum degismez",
      "steps": [
        { "rpc": "create_character", "args": { "p_key": "zz-v-idemdiff", "p_display_name": "zz-v-idemdiff", "p_holder": "srvA:boot1", "p_op_id": "00000000-0000-4000-8000-000000000018", "p_schema_version": 2, "p_data": "@envelope_a" },
          "expect": { "outcome": "committed" } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-idemdiff", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000019", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "committed", "revision": 1 } },
        { "rpc": "save_character", "args": { "p_key": "zz-v-idemdiff", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 0, "p_op_id": "00000000-0000-4000-8000-000000000019", "p_schema_version": 2, "p_data": "@envelope_c" },
          "expect": { "outcome": "idempotency_conflict" }, "exact": true },
        { "rpc": "save_character", "args": { "p_key": "zz-v-idemdiff", "p_holder": "srvA:boot1", "p_epoch": 1, "p_expected_revision": 1, "p_op_id": "00000000-0000-4000-8000-000000000019", "p_schema_version": 2, "p_data": "@envelope_b" },
          "expect": { "outcome": "idempotency_conflict" }, "exact": true },
        { "rpc": "load_character", "args": { "p_key": "zz-v-idemdiff" },
          "expect": { "revision": 1, "data": "@envelope_b" } }
      ]
    },
    {
      "id": "op_id_reused_for_other_key",
      "description": "bir op_id baska anahtarda kullanilamaz",
      "steps": [
        { "rpc": "create_character", "args": { "p_key": "zz-v-opa", "p_display_name": "zz-v-opa", "p_holder": "srvA:boot1", "p_op_id": "00000000-0000-4000-8000-000000000020", "p_schema_version": 2, "p_data": "@envelope_a" },
          "expect": { "outcome": "committed" } },
        { "rpc": "create_character", "args": { "p_key": "zz-v-opb", "p_display_name": "zz-v-opb", "p_holder": "srvA:boot1", "p_op_id": "00000000-0000-4000-8000-000000000021", "p_schema_version": 2, "p_data": "@envelope_a" },
          "expect": { "outcome": "committed" } },
