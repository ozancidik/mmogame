# Unreal Engine .gitignore

# Visual Studio / IDE
.vs/
.vscode/
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
UpgradeLog.htm
UpgradeLog*.htm

# Unreal generated
Binaries/
DerivedDataCache/
Intermediate/
Saved/
.vsconfig

# Build
Build/

# Cache
*.tps

# Ignore packages
Plugins/*/Binaries/
Plugins/*/Intermediate/

# Raw DCC source (FBX staging) - imported .uasset lives in Content/, so raw is redundant
Art/

# Compiled source
*.pyc

# Mac/OS
.DS_Store

# Guvenlik (docs/SECURITY_AUDIT.md): IDE ayarlari, kayit dosyalari ve sirlar yanlislikla commit'lenmesin
.idea/
*.sav
.env
.env.*

# Supabase CLI (docs/DESIGN_SUPABASE.md 3.5): yerel gecici dosyalar ve sirlar
supabase/.temp
supabase/.branches
supabase/.env*
